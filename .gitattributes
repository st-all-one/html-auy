# html-auy — line endings and repository classification.
#
# The project requires LF everywhere: rustfmt uses Unix newlines, Python tools and
# documentation are compared as bytes, and CRLF would create noisy diffs.

* text=auto eol=lf

# Source, data, generated tables, and documentation.
*.rs            text eol=lf
*.md            text eol=lf
*.toml          text eol=lf
*.json          text eol=lf
*.jsonl         text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.sh            text eol=lf
*.py            text eol=lf
*.txt           text eol=lf
*.html          text eol=lf
*.css           text eol=lf
*.svg           text eol=lf
*.stderr        text eol=lf
*.snap          text eol=lf
Cargo.lock      text eol=lf

# Binary artifacts: never normalize.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.woff  binary
*.woff2 binary
*.gguf  binary
*.bin   binary

# GitHub Linguist: the product is Rust; docs, LLM context, and generated tables
# should not distort the language breakdown.
*.md                    linguist-documentation
docs/**                 linguist-documentation
llms.txt                linguist-documentation
llms-full.txt           linguist-documentation
SKILL.md                linguist-documentation
AGENTS.md               linguist-documentation
crates/html-auy/src/spec/table.rs              linguist-generated
crates/html-auy-macros-core/src/table.rs       linguist-generated
Cargo.lock              linguist-generated
